# Copy this file to split-it.env (same folder as server.js), fill in what you use,
# then restart:  systemctl --user restart split-it
# Leave a line empty to keep that feature off.

# The address people open, used in email links and for Google. No slash at the end.
PUBLIC_URL=https://your-laptop.your-tailnet.ts.net

# Emails (check your email, forgot password, email sign-in links), from resend.com
RESEND_API_KEY=
MAIL_FROM=Split it <hello@yourdomain.com>

# "Continue with Google", from console.cloud.google.com (OAuth client, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A second place for backups that isn't this laptop's disk: a USB drive, or a folder that
# Dropbox, Syncthing or Nextcloud sends somewhere else. A full zip goes there once a day, 14 are kept.
# The owner's page warns when this is empty or the copy is getting old.
BACKUP_COPY_DIR=

# The hour (0 to 23, laptop time) after which bill reminders go out.
REMIND_HOUR=9

# The owner's page asks GitHub whether a newer Split it is out (nothing about your house is sent).
# Write off to stop that.
UPDATE_CHECK=

# Behind a proxy (Docker, Traefik, Coolify, Caddy, nginx, a Cloudflare tunnel), Split it reads the visitor's real
# address from the proxy's headers, so one person's wrong passwords don't lock everyone out. By default it believes
# those headers only from this computer and private network addresses (10.x, 172.16-31.x, 192.168.x, fc00::/7).
# List your proxy's addresses or ranges here to believe only those, or write none to never believe the headers.
# TRUSTED_PROXY=10.0.2.6,172.18.0.0/16
