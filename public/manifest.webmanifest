      "name": "Add an expense",
      "short_name": "Add",
      "url": "/?do=add",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Settle up",
      "short_name": "Settle",
      "url": "/?do=settle",
